# ==============================================================================
# GXE-Search-Queue — environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ==============================================================================

# --- General ----------------------------------------------------------------
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# --- REST API --------------------------------------------------------------
# Bind address and port for the control-plane API
API_BIND_ADDR=0.0.0.0
API_PORT=8080
# Secret used to sign API/auth tokens (change in production!)
API_SECRET=change-me

# --- Dashboard ------------------------------------------------------------
# Bind address and port for the web dashboard
DASHBOARD_BIND_ADDR=0.0.0.0
DASHBOARD_PORT=8081

# --- Database (PostgreSQL) ------------------------------------------------
DATABASE_URL=postgres://gxe:gxe@localhost:5432/gxe_search_queue
DATABASE_POOL_MAX=10
# Enable migrations on startup (true/false)
DATABASE_AUTO_MIGRATE=true

# --- Cache / coordination (Redis) ----------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_LOCK_TTL_SECONDS=30

# --- Scheduler ------------------------------------------------------------
# Default timezone for cron expressions, e.g. UTC, Europe/Rome
SCHEDULER_TIMEZONE=UTC

# --- Notifications -------------------------------------------------------
# Webhook endpoint used for job lifecycle events (optional)
NOTIFY_WEBHOOK_URL=
# Email SMTP settings (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=gxe-search-queue@example.com

# --- Integrations --------------------------------------------------------
# Connector-specific configuration lives in config/ or as env vars,
# e.g. SEARCH_PROVIDER_API_KEY=change-me
