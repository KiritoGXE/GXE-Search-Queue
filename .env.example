# Choose a unique random token with at least 32 characters.
GXE_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters
GXE_PORT=8080
RUST_LOG=info

# Service URLs must be reachable from the app container; use Docker service names.
# Seerr request synchronization and the *Arr integrations require API keys.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
